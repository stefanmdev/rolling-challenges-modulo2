//El calculador de minutos:  Diseñar un algoritmo que permita al usuario ingresar una cantidad de horas
//y muestre por pantalla a cuántos minutos equivalen.

Algoritmo horasMinutos
	Definir horas, minutos Como Entero;
	Escribir 'Ingrese la cantidad de horas que deseas convertir a minutos';
	Leer horas;
	minutos = horas * 60;
	Escribir 'Equivale a ' minutos, ' minutos';
FinAlgoritmo
