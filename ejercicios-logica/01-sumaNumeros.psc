//Realizar una suma de dos números y mostrar el resultado
Algoritmo sumatoria
	//crear o definir variables
	Definir numero1, numero2 Como Entero;
	//cargar valores en las variables 
	Escribir "Ingresa el primer numero";
	Leer numero1;
	Escribir "Ingresa el segundo numero";
	Leer numero2;
	Escribir 'La suma de los dos numeros es = ' numero1 + numero2;
FinAlgoritmo

